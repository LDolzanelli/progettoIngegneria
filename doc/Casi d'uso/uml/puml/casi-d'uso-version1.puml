@startuml
skinparam actorStyle "awesome"
left to right direction

title Diagramma dei Casi d'Uso - Versione 1

actor Configuratore

(Accesso) as UC_Accesso
(Modifica Credenziali) as UC_ModCred
(Creazione del corpo dati) as UC_Corpo
(Gestione numero max di iscrizioni) as UC_NumMax
(Visualizzazione dei luoghi di interesse) as UC_ViewLuoghi
(Visualizzazione dei tipi di visita di un luogo di interesse) as UC_ViewVisite
(Inserimento luoghi di interesse) as UC_AddLuogo
(Inserimento Tipo di visita ad un luogo esistente) as UC_AddVisita
(Visualizzazione volontari) as UC_ViewVolontari
(Inserimento volontario) as UC_AddVolontario
(Inserimento delle date da precludere) as UC_Date

' --- Associazioni con attore ---
Configuratore --> UC_Accesso
Configuratore --> UC_Corpo
Configuratore --> UC_NumMax
Configuratore --> UC_ViewLuoghi
Configuratore --> UC_ViewVisite
Configuratore --> UC_AddLuogo
Configuratore --> UC_AddVisita
Configuratore --> UC_ViewVolontari
Configuratore --> UC_AddVolontario
Configuratore --> UC_Date

' --- Include ---
UC_Accesso .right.> UC_ModCred : <<include>>
UC_ModCred .down.> UC_Accesso : <<include>>
UC_ViewVisite .down.> UC_ViewLuoghi : <<include>>
UC_AddLuogo .down.> UC_ViewLuoghi : <<include>>
UC_AddVisita .right.> UC_ViewVisite : <<include>>
UC_AddVisita .down.> UC_AddVolontario : <<include>>
UC_AddVolontario .down.> UC_ViewVolontari : <<include>>
@enduml
