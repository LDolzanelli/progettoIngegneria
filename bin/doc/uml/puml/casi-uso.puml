@startuml
top to bottom direction
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor Black
  ArrowColor Black
}

actor Configuratore

usecase "Accesso del Configuratore" as UC1
usecase "Modifica Credenziali del Configuratore" as UC2
usecase "Visualizzazione dei Dati" as UC3
usecase "Avvio del Corpo Dati" as UC4
usecase "Gestione Numero Max Iscritti" as UC5
usecase "Creazione del Corpo Dati" as UC6
usecase "Inserire Luogo Visita" as UC7


Configuratore --> UC1
Configuratore --> UC2
Configuratore --> UC3
Configuratore --> UC4
Configuratore --> UC5
Configuratore --> UC6

UC1 ..> UC2 : <<include>>
UC6 ..> UC5 : <<include>>
UC6 ..> UC7 : <<include>>
@enduml